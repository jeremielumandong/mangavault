# Copy to config.env (gitignored) and fill in. Used by the backend deploy and both app builds.
# Never commit real values: CI reads the same names from repository secrets.
API_DOMAIN=api.example.com
# From `npx wrangler d1 create mangavault` (backend deploy only).
D1_DATABASE_ID=
# Google Sign-In. The web client id is what Android's Credential Manager asks for
# (and must be in the Worker's GOOGLE_AUDIENCES); the iOS client id is for the iOS app.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
